{
  "version": "2.0",
  "configurationProfile": "mcp-custom-handler",
  "functionTimeout": "00:03:30",
  "customHandler": {
    "description": {
      "defaultExecutablePath": "python",
      "arguments": ["server.py"]
    },
    "http": {
      "defaultAuthorizationLevel": "function"
    },
    "port": "8000"
  },
  "logging": {
    "logLevel": {
      "default": "Warning"
    }
  }
}
